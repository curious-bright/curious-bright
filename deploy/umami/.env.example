# Copy to .env and generate strong values. Never commit .env.
POSTGRES_PASSWORD=replace-with-a-long-random-password
APP_SECRET=replace-with-at-least-32-random-bytes
UMAMI_PORT=3000
TRACKER_SCRIPT_NAME=script.js

# Only needed for the optional Cloudflare Tunnel profile.
CLOUDFLARE_TUNNEL_TOKEN=

# Only needed for the optional Caddy profile.
UMAMI_DOMAIN=analytics.curiousbright.com.ng
