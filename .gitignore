dist/
.next/
.prerender/

# Environment files: real values are never committed, templates always are.
.env
.env.*
!.env.example
!.env.template

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Turbo
.turbo/

