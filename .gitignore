pgdata/
miniodata/

# Misc
*.log
.commandcode/

# Python / Django backend (apps/backend)
__pycache__/
*.py[cod]
*.sqlite3
.venv/
venv/
staticfiles/
media/
private_media/

# Local credentials / scratch files
cookies.txt
/.txt

# Google/Firebase service account keys (the FCM V1 push credential). The
# private key inside is what lets anyone send push to our Android users.
# google-services.json is the public counterpart and stays tracked.
*firebase-adminsdk*.json
service-account*.json
*-service-account*.json


# Qoder CLI session data
.qoder/
