# Copy to .env.production (or set the same keys in the Vercel project — that
# file is no longer committed). Production builds read these at build time.

# Public API origin (no trailing slash). In production use the API subdomain.
VITE_API_URL=https://api.curiousbright.com.ng

# Institutional portal where pricing CTAs send verified organizations.
VITE_ORG_URL=https://org.curiousbright.com.ng

# Paystack public integration key (pk_live_... / pk_test_...). Safe to expose in
# the browser bundle; the secret key belongs to the backend only.
VITE_PAYSTACK_PUBLIC_KEY=

# Self-hosted Umami (recommended) or Umami Cloud. Leave both blank to disable
# analytics. Never put personal data or message content into event payloads.
VITE_UMAMI_SCRIPT_URL=
VITE_UMAMI_WEBSITE_ID=
