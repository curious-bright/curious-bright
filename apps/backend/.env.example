# --- Django core ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# --- Database (PostgreSQL in production) ---
# Leave DATABASE_URL empty for the local SQLite fallback (apps/backend/db.sqlite3),
# or set USE_SQLITE=true to force SQLite.
DATABASE_URL=
# Example when using Docker Compose:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/curiousbright
# USE_SQLITE=true

# --- Admin bootstrap (used by `manage.py ensure_admin` + data migration) ---
# Required on first deploy, otherwise admin creation fails loudly (ensure_admin)
# or is silently skipped (data migration). Never commit real values.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-unique-password

# --- Frontend origins for CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# --- Soft delete retention ---
SOFT_DELETE_UNDO_SECONDS=300
SOFT_DELETE_RETENTION_DAYS=30

# --- Real-time (Channels) ---
# Required in production (more than one worker). Example: redis://default:pass@host:6379
REDIS_URL=
# Browser sockets authenticate with a single-use ticket fetched over HTTP, so
# access tokens never appear in proxy/access logs. Tickets expire quickly.
WS_TICKET_TTL_SECONDS=60

# --- Live video (LiveKit) ---
# The browser connects to the websocket URL; the API mints short-lived tokens.
# Leave blank to show the friendly "video is not configured" state.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL_SECONDS=7200

# --- Organizations / public clients / email ---
APP_FRONTEND_URL=https://app.curiousbright.com.ng
ORG_FRONTEND_URL=https://org.curiousbright.com.ng
LANDING_FRONTEND_URL=https://curiousbright.com.ng
# WebSocket origins. Defaults to CORS_ALLOWED_ORIGINS when omitted.
WS_ALLOWED_ORIGINS=
# Organization creation is allowed only from these exact origins. The portal
# also sends X-Client-App: institutional.
ORG_REGISTRATION_ALLOWED_ORIGINS=https://org.curiousbright.com.ng,http://localhost:5174,http://127.0.0.1:5174
# Private verification documents. Never serve this directory from /media/.
PRIVATE_MEDIA_ROOT=
# Existing invitation/moderation mail uses Django's EMAIL_BACKEND.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

# New registration-verification and password-reset mail uses EMAIL_PROVIDER:
#   console -> print to the terminal (local development with EMAIL_BACKEND=console)
#   django  -> use EMAIL_BACKEND above
#   resend  -> Resend HTTPS API (production)
# Keep console locally even if RESEND_API_KEY is present so testing never sends
# real mail. Set EMAIL_PROVIDER=resend in production.
EMAIL_PROVIDER=console
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com/emails
RESEND_TIMEOUT_SECONDS=10
RESEND_MAX_ATTEMPTS=3
RESEND_RETRY_BASE_SECONDS=1
DEFAULT_FROM_EMAIL=noreply@curiousbright.com.ng
EMAIL_FROM_NAME=CuriousBright
SUPPORT_EMAIL=support@curiousbright.com.ng
EMAIL_REPLY_TO=support@curiousbright.com.ng

# Production defaults EMAIL_DELIVERY_ASYNC=true; local DEBUG defaults false.
# The resend-code endpoint waits up to this many seconds for a known result so a
# Resend outage can raise an immediate alert.
EMAIL_DELIVERY_ASYNC=false
EMAIL_DELIVERY_WAIT_SECONDS=8
EMAIL_VERIFICATION_CODE_TTL_SECONDS=600
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_EMAIL_HOURLY_LIMIT=5
EMAIL_VERIFICATION_IP_HOURLY_LIMIT=10
PASSWORD_RESET_TOKEN_TTL_SECONDS=1800
PASSWORD_RESET_COOLDOWN_SECONDS=60
PASSWORD_RESET_EMAIL_HOURLY_LIMIT=5
PASSWORD_RESET_IP_HOURLY_LIMIT=10

# --- Billing (Paystack) ---
# The institutional portal handles the return URL and verifies the reference.
BILLING_CALLBACK_URL=https://org.curiousbright.com.ng/billing/verify
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_API_BASE=https://api.paystack.co
# Amounts are minor units (kobo/cents). Pro defaults to NGN 5,000 / USD 12.
BILLING_PRO_NGN=500000
BILLING_PRO_USD=1200
