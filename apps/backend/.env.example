# --- Django core ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database (PostgreSQL in production) ---
# Leave DATABASE_URL empty for the local SQLite fallback (apps/backend/db.sqlite3),
# or set USE_SQLITE=true to force SQLite.
DATABASE_URL=postgres://user:password@localhost:5432/curiousbright
# USE_SQLITE=true

# --- Admin bootstrap (used by `manage.py ensure_admin` + data migration) ---
# Required on first deploy, otherwise admin creation fails loudly (ensure_admin)
# or is silently skipped (data migration). Never commit real values.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# --- Frontend origins for CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Soft delete retention ---
SOFT_DELETE_UNDO_SECONDS=300
SOFT_DELETE_RETENTION_DAYS=30

# --- Real-time (Channels) ---
# Required in production (more than one worker). Example: redis://default:pass@host:6379
REDIS_URL=

# --- Organizations / email ---
ORG_FRONTEND_URL=https://org.curiousbright.com.ng
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@curiousbright.com.ng
