# Copy to .env.production, or set the same keys in the Vercel project — that
# file is no longer committed, so the platform must supply these or the
# production bundle will build pointing at http://127.0.0.1:8000.

# Django API base URL used by the browser bundle.
# Leave blank in development: the default is http://127.0.0.1:8000.
# In production use the public API origin, e.g. https://api.curiousbright.com.ng
VITE_API_URL=

# Optional explicit WebSocket origin. By default the app derives ws:// or wss://
# from VITE_API_URL.
VITE_WS_URL=

# Link used by the institution application page. The selected organization slug
# is appended to this URL.
VITE_ORG_URL=https://org.curiousbright.com.ng

# Google OAuth web client ID (Google Cloud Console → Credentials). The
# "Continue with Google" buttons stay hidden while this is empty. The matching
# backend envs are GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / GOOGLE_REDIRECT_URI,
# and the redirect URI https://app.curiousbright.com.ng/auth/google/callback
# (plus the local dev origin) must be authorized in Google Cloud.
VITE_GOOGLE_CLIENT_ID=

# Self-hosted Umami analytics. Analytics is completely disabled when these
# empty. Only coarse page/event names are ever sent; never message content.
VITE_UMAMI_SCRIPT_URL=
VITE_UMAMI_WEBSITE_ID=
