# Copy to .env (gitignored). All values are optional.
# API base URL. When unset, the app derives the dev backend host from the
# Metro server (http://<lan-ip>:8000), falling back to 10.0.2.2 (Android
# emulator) or 127.0.0.1.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
# EXPO_PUBLIC_WS_URL=ws://192.168.1.10:8000

# Google sign-in. Register `https://app.curiousbright.com.ng/auth/google/mobile`
# as an authorized redirect URI on the OAuth client (Google rejects custom
# schemes there; that page relays the code back via curiousbright://auth/google).
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
# Optional: point at a branch/preview web deployment instead.
# EXPO_PUBLIC_GOOGLE_RELAY_ORIGIN=https://app.curiousbright.com.ng
