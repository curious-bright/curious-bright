{
  "expo": {
    "name": "CuriousBright",
    "slug": "curious-bright",
    "scheme": "curiousbright",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.diawhiz.curiousbright"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F6F2"
      },
      "package": "com.diawhiz.curiousbright"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withAndroidCleartext",
      "expo-router",
      "expo-secure-store",
      "expo-document-picker",
      "expo-image",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F6F2"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose an image to use as your profile avatar."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e26f158c-3a7b-41cd-9133-d0acfbc4bd98"
      }
    }
  }
}
