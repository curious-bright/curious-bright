{
  "expo": {
    "name": "CuriousBright",
    "slug": "curiousbright",
    "scheme": "curiousbright",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/8c557c1f-10b6-4b2e-bb01-202136089381",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.diawhiz.curiousbright"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F6F2"
      },
      "package": "com.diawhiz.curiousbright"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withAndroidCleartext",
      "expo-router",
      "expo-secure-store",
      "expo-document-picker",
      "expo-image",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#F4B43D"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F6F2"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose an image to use as your profile avatar."
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8c557c1f-10b6-4b2e-bb01-202136089381"
      }
    }
  }
}
