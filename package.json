{
  "name": "curious-bright",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "start": "bash apps/backend/scripts/start.sh",
    "backend:dev": "apps/backend/.venv/bin/python apps/backend/manage.py runserver 0.0.0.0:8000",
    "backend:migrate": "apps/backend/.venv/bin/python apps/backend/manage.py migrate",
    "backend:admin": "apps/backend/.venv/bin/python apps/backend/manage.py ensure_admin",
    "dev": "pnpm --filter web dev",
    "dev:all": "turbo run dev",
    "web:dev": "pnpm --filter web dev",
    "web:build": "pnpm --filter web build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "18.3.31"
    }
  },
  "packageManager": "pnpm@9.0.0"
}
